[Unit]
Description=SudoClaude voice guard (pauses voice for games and low memory)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/Projects/SudoClaude/bin/sudoclaude-guard
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=graphical-session.target
