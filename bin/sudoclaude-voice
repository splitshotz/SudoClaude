#!/usr/bin/env bash
# listen and stop are meant for keybinds, so they skip the heavy Python and just
# signal the running assistant (or start it).
run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
venv="${SUDOCLAUDE_VENV:-$HOME/.local/share/sudoclaude/venv}"
unit=sudoclaude-voice.service

if [[ "$1" == listen ]]; then
    # During a game the heavy voice models never load: Super+Space opens the
    # light typing box instead, which (with its overlay) closes again when done.
    game="$(cd "$here" && /usr/bin/python3 -m sudoclaude.gamemode 2>/dev/null)"
    [[ "$game" == "no game" ]] && game=""
    # Voice switched off in settings, or the guard paused it for low memory:
    # typing-only Claude, which loads no speech models and starts at once.
    voice_on="$(/usr/bin/python3 -c 'import json,os
try: print(json.load(open(os.path.expanduser("~/.config/sudoclaude/config.json"))).get("voice",{}).get("enabled",True) is not False)
except Exception: print(True)' 2>/dev/null)"
    if [[ -n "$game" || "$voice_on" != True || -f "$run/sudoclaude-voice-paused" ]]; then
        pid="$(cat "$run/sudoclaude-text.pid" 2>/dev/null)"
        if [[ -n "$pid" ]] && grep -qa sudoclaude.voice "/proc/$pid/cmdline" 2>/dev/null; then
            exec kill -USR1 "$pid"
        fi
        cd "$here" && exec setsid "$venv/bin/python" -m sudoclaude.voice text \
            > /dev/null 2>> "$run/sudoclaude-text.err" < /dev/null
    fi
    # On demand: the voice isn't kept running (it exits after idle_exit_minutes
    # unused, or when a game starts), so the first press starts it and it begins
    # listening as soon as its models are loaded.
    state="$(systemctl --user is-active "$unit")"
    if [[ "$state" != active ]]; then
        touch "$run/sudoclaude-voice.listen-on-ready"
        [[ "$state" == activating ]] && exit 0
        notify-send -a SudoClaude -i audio-input-microphone -t 3000 \
            "Starting Claude's voice" "It'll start listening in a few seconds."
        exec systemctl --user start --no-block "$unit"
    fi
    exec systemctl --user kill --kill-whom=main -s USR1 "$unit"
fi
case "$1" in
    # The assistant watches this file, which is quicker than a signal mid-answer.
    stop) exec touch "$run/sudoclaude-voice.stop" ;;
esac
cd "$here" && exec "$venv/bin/python" -m sudoclaude.voice "$@"
